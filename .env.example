# KaneAI agent runtime — secrets & deployment toggles only.
# Public constants (chains, tokens, attribution tag, x402 URLs, LLM defaults) live in
# src/constants.ts. Copy this file to .env and fill. NEVER commit .env.

# --- Network toggle ---
NETWORK=celo_sepolia            # celo | celo_sepolia
# RPC_URL=                      # optional RPC override (defaults to the chain's public RPC)

# --- Secrets (keep private) ---
AGENT_PRIVATE_KEY=              # dedicated agent wallet key — NOT your main wallet
AI_AUTH_TOKEN=                  # LLM key (dgrid.ai)
X402_API_KEY=                   # x402 facilitator credits key (https://x402.celo.org)

# --- x402 (Track 2) ---
X402_NETWORK=testnet            # testnet | mainnet
X402_PAY_TO=                    # seller receiving wallet (public address; receives the USDC)

# --- Optional overrides (sensible defaults already in src/constants.ts) ---
# FACTORY_ADDRESS=              # KaneVaultFactory (else read from constants DEPLOYMENTS)
# VAULT_ADDRESS=
# LLM_BASE_URL=https://api.dgrid.ai/v1
# LLM_MODEL=anthropic/claude-haiku-4.5
# X402_PRICE=10000              # $0.01 in USDC base units
# PORT=8787
