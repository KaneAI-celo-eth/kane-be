# --- Network ---
# celo | celo_sepolia   (deploy/dev on sepolia first, mainnet for the hackathon)
NETWORK=celo_sepolia
# Optional RPC override (defaults to the chain's public RPC)
RPC_URL=

# --- Agent wallet (dedicated key — NEVER the main wallet) ---
AGENT_PRIVATE_KEY=0x

# --- Deployed contracts (fill after `forge script Deploy`) ---
FACTORY_ADDRESS=0x
VAULT_ADDRESS=0x

# --- Attribution tag (KaneAI registered tag; must be in every tx) ---
ATTRIBUTION_TAG=celo_ac1c160afeb3

# --- LLM (OpenAI-compatible; default: dgrid.ai) ---
AI_AUTH_TOKEN=
LLM_BASE_URL=https://api.dgrid.ai/v1
LLM_MODEL=anthropic/claude-haiku-4.5

# --- x402 (Track 2: pay-per-request settlements) ---
# Facilitator credits key from https://x402.celo.org dashboard (human creates it once).
X402_API_KEY=
# testnet | mainnet
X402_NETWORK=testnet
# Seller's own receiving wallet (gets the USDC). Settlements here are counted for Track 2.
X402_PAY_TO=0x
# Price per paid request in USDC base units (6 decimals). "10000" = $0.01
X402_PRICE=10000

# --- Gateway ---
PORT=8787
