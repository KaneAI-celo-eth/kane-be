# KaneAI agent runtime — secrets & deployment toggles only.
# Public constants (chains, tokens, attribution tag, x402 URLs, LLM defaults) live in
# src/constants.ts. Copy to .env and fill. NEVER commit .env.
# Keep comments on their own lines — inline comments after a value can be parsed into it.

# Network: celo | celo_sepolia
NETWORK=celo_sepolia
# Optional RPC override (defaults to the chain's public RPC)
# RPC_URL=

# --- Secrets (keep private) ---
# Dedicated agent wallet key — NOT your main wallet
AGENT_PRIVATE_KEY=
# LLM key (dgrid.ai)
AI_AUTH_TOKEN=
# x402 facilitator credits key (https://x402.celo.org)
X402_API_KEY=

# --- x402 (Track 2) ---
# testnet | mainnet
X402_NETWORK=testnet
# Seller receiving wallet (public address; receives the USDC)
X402_PAY_TO=

# --- Optional overrides (defaults in src/constants.ts) ---
# FACTORY_ADDRESS=
# VAULT_ADDRESS=
# LLM_BASE_URL=https://api.dgrid.ai/v1
# LLM_MODEL=anthropic/claude-haiku-4.5
# X402_PRICE=10000
# PORT=8787
