{
  "name": "kane-be",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "KaneAI agent runtime — proposes actions, dry-runs the on-chain policy, and executes tagged transactions on Celo.",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "start": "bun run src/server.ts",
    "cli": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "e2e:anvil": "bash scripts/e2e-anvil.sh",
    "mento-check": "NETWORK=celo bun scripts/mento-swap-check.ts",
    "add-mento-venue": "bun scripts/add-mento-venue.ts",
    "sync-celopedia": "bash scripts/sync-celopedia.sh",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.3.0",
    "@mento-protocol/mento-sdk": "^3.3.1",
    "@x402/core": "^2.19.0",
    "@x402/evm": "^2.19.0",
    "@x402/fetch": "^2.19.0",
    "@x402/hono": "^2.19.0",
    "hono": "^4.12.31",
    "viem": "^2.55.8"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
